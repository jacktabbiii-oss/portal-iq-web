.ipynb_checkpoints
*.ipynb

# Data files - Raw and Cache (don't commit large data files)
/data/raw/
/data/cache/
*.csv
*.xlsx
*.json
!config.yaml

# Model files (large binary files)
/models/*.joblib
/models/*.pkl
/models/*.h5
/models/*.pt
*.joblib
*.pkl

# Outputs
/outputs/reports/*.pdf
/outputs/reports/*.html
/outputs/figures/*.png
/outputs/figures/*.html

# Logs
*.log
logs/

# Testing
.coverage
htmlcov/
.tox/
.nox/
.pytest_cache/
pytest_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

